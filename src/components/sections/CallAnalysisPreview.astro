---
import { Sparkles, TrendingUp, TriangleAlert, ListChecks } from 'lucide-astro';

/**
 * Ilustração estática da análise de uma ligação no Sonar.
 * Conteúdo meramente demonstrativo — não representa dados de clientes reais.
 */

const objections = [
  { label: 'Preço acima do orçamento', tone: 'rose' },
  { label: 'Precisa validar com o sócio', tone: 'amber' },
] as const;

const toneClasses = {
  rose: 'bg-rose-50 text-rose-700',
  amber: 'bg-amber-50 text-amber-700',
} as const;

const nextSteps = [
  'Enviar proposta revisada até sexta',
  'Agendar call com o sócio na próxima semana',
];
---

<div class="relative">
  <div
    class="rounded-xl border border-slate-200 bg-white p-6 shadow-lg"
    role="img"
    aria-label="Exemplo de análise de ligação gerada pelo Sonar: score de qualidade 87, resumo automático, objeções identificadas e próximos passos."
  >
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">
          Ligação analisada
        </p>
        <p class="mt-1 text-sm font-semibold text-slate-900">
          Reunião de descoberta · 24 min
        </p>
      </div>
      <div
        class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-full border-4 border-teal-600 bg-teal-50"
      >
        <span class="text-lg font-semibold leading-none text-teal-700">87</span>
        <span class="text-[10px] font-medium uppercase text-teal-600">score</span>
      </div>
    </div>

    <div class="mt-5 rounded-lg bg-sky-100 p-4">
      <p
        class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-sky-800"
      >
        <Sparkles class="h-3.5 w-3.5" aria-hidden="true" />
        Resumo por IA
      </p>
      <p class="mt-2 text-sm font-medium leading-relaxed text-sky-900">
        O cliente busca reduzir o tempo de resposta do time comercial. Demonstrou
        interesse na análise automática, mas o preço ficou acima do orçamento
        previsto para o trimestre.
      </p>
    </div>

    <div class="mt-5">
      <p
        class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-slate-500"
      >
        <TriangleAlert class="h-3.5 w-3.5" aria-hidden="true" />
        Objeções identificadas
      </p>
      <div class="mt-2 flex flex-wrap gap-2">
        {
          objections.map((objection) => (
            <span
              class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ${toneClasses[objection.tone]}`}
            >
              {objection.label}
            </span>
          ))
        }
      </div>
    </div>

    <div class="mt-5 border-t border-slate-200 pt-5">
      <p
        class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wide text-slate-500"
      >
        <ListChecks class="h-3.5 w-3.5" aria-hidden="true" />
        Próximos passos
      </p>
      <ul class="mt-2 space-y-2">
        {
          nextSteps.map((step) => (
            <li class="flex items-start gap-2 text-sm font-medium text-slate-700">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-teal-600" />
              {step}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div
    class="absolute -bottom-6 -left-4 hidden rounded-xl border border-slate-200 bg-white p-4 shadow-lg sm:block"
  >
    <p class="flex items-center gap-1.5 text-xs font-medium text-slate-500">
      <TrendingUp class="h-3.5 w-3.5 text-emerald-500" aria-hidden="true" />
      Score médio do time
    </p>
    <p class="mt-1 text-2xl font-semibold tracking-tight text-slate-900">
      72 <span class="text-sm font-medium text-emerald-600">+9 pts</span>
    </p>
  </div>
</div>
