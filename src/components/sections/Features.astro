---
import {
  AudioLines,
  Sparkles,
  Gauge,
  MessageSquareWarning,
  GraduationCap,
  BarChart3,
} from 'lucide-astro';
import Container from '../ui/Container.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import { FEATURES, type FeatureIcon } from '../../data/features';

const ICONS: Record<FeatureIcon, typeof AudioLines> = {
  'audio-lines': AudioLines,
  sparkles: Sparkles,
  gauge: Gauge,
  'message-square-warning': MessageSquareWarning,
  'graduation-cap': GraduationCap,
  'bar-chart-3': BarChart3,
};
---

<section id="recursos" class="scroll-mt-20 bg-white py-16 md:py-24">
  <Container>
    <SectionTitle
      eyebrow="Recursos"
      title="Tudo que acontece na ligação, organizado para você agir"
      description="O Sonar transforma áudio bruto em informação estruturada sobre o seu processo comercial."
    />

    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        FEATURES.map((feature) => {
          const Icon = ICONS[feature.icon];
          return (
            <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition-transform duration-200 hover:-translate-y-0.5">
              <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-teal-50">
                <Icon class="h-5 w-5 text-teal-700" aria-hidden="true" />
              </div>
              <h3 class="mt-4 text-lg font-semibold text-slate-900">
                {feature.title}
              </h3>
              <p class="mt-2 text-sm font-medium leading-relaxed text-slate-500">
                {feature.description}
              </p>
            </div>
          );
        })
      }
    </div>
  </Container>
</section>
