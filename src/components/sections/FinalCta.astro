---
import { ArrowRight } from 'lucide-astro';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { APP_URLS } from '../../data/site';
---

<section class="bg-slate-900 py-16 md:py-24">
  <Container>
    <div class="mx-auto max-w-3xl text-center">
      <h2
        class="text-3xl font-semibold tracking-tight text-white md:text-4xl"
      >
        O próximo treinamento do seu time pode começar com
        <span class="text-teal-400">dado real</span>
      </h2>
      <p class="mt-4 text-base font-medium text-slate-300 md:text-lg">
        Fale com o time comercial, entenda como o Sonar se encaixa na sua
        operação e veja em minutos o que dá para treinar a partir de uma
        ligação real.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <Button href={APP_URLS.comercial} size="lg" external>
          Falar com o comercial
          <ArrowRight class="h-4 w-4" aria-hidden="true" />
        </Button>
        <Button href={APP_URLS.login} variant="dark" size="lg">
          Entrar na plataforma
        </Button>
      </div>
    </div>
  </Container>
</section>
