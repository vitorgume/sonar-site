---
import { Menu } from 'lucide-astro';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { APP_URLS, NAV_LINKS } from '../../data/site';
---

<header
  class="sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur"
>
  <Container>
    <div class="flex h-20 items-center justify-between gap-6">
      <a href="/" class="flex items-center rounded-lg" aria-label="Sonar — página inicial">
        <img
          src="/logos/sonar-lockup.svg"
          alt="Sonar"
          width="420"
          height="132"
          class="h-14 w-auto"
        />
      </a>

      <nav aria-label="Navegação principal" class="hidden lg:block">
        <ul class="flex items-center gap-8">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="rounded text-sm font-medium text-slate-600 transition-colors hover:text-teal-700"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="hidden items-center gap-3 lg:flex">
        <a
          href={APP_URLS.login}
          class="rounded-lg px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:text-teal-700"
        >
          Entrar
        </a>
        <!-- <Button href={APP_URLS.register} class="text-sm">Criar conta</Button> -->
      </div>

      <details class="group relative lg:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-300 text-slate-700 transition-colors hover:bg-slate-50 [&::-webkit-details-marker]:hidden"
          aria-label="Abrir menu de navegação"
        >
          <Menu class="h-5 w-5" aria-hidden="true" />
        </summary>
        <nav
          aria-label="Navegação principal (mobile)"
          class="absolute right-0 top-12 w-64 rounded-xl border border-slate-200 bg-white p-4 shadow-lg"
        >
          <ul class="flex flex-col gap-1">
            {
              NAV_LINKS.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="block rounded-lg px-3 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="mt-3 flex flex-col gap-2 border-t border-slate-200 pt-3">
            <Button href={APP_URLS.register} class="w-full text-sm">
              Criar conta
            </Button>
            <Button
              href={APP_URLS.login}
              variant="secondary"
              class="w-full text-sm"
            >
              Entrar
            </Button>
          </div>
        </nav>
      </details>
    </div>
  </Container>
</header>
