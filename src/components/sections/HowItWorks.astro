---
import { ArrowRight } from 'lucide-astro';
import Container from '../ui/Container.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';
import { STEPS } from '../../data/steps';
import { APP_URLS } from '../../data/site';
---

<section id="como-funciona" class="scroll-mt-24 bg-slate-50 py-16 md:py-24">
  <Container>
    <SectionTitle
      eyebrow="Como funciona"
      title="Três passos entre a ligação e o treinamento"
      description="Nenhuma mudança de ferramenta, nenhum projeto de implantação. O time continua vendendo do mesmo jeito — e passa a aprender com cada call."
    />

    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {
        STEPS.map((step) => (
          <li class="relative rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <span class="text-sm font-semibold uppercase tracking-wide text-teal-600">
              {step.number}
            </span>
            <h3 class="mt-3 text-lg font-semibold text-slate-900">
              {step.title}
            </h3>
            <p class="mt-2 text-sm font-medium leading-relaxed text-slate-500">
              {step.description}
            </p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 flex justify-center">
      <Button href={APP_URLS.comercial} size="lg" external>
        Falar com o comercial
        <ArrowRight class="h-4 w-4" aria-hidden="true" />
      </Button>
    </div>
  </Container>
</section>
