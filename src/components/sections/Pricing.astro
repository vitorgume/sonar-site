---
import { Check } from 'lucide-astro';
import Container from '../ui/Container.astro';
import SectionTitle from '../ui/SectionTitle.astro';
import Button from '../ui/Button.astro';
import { PLANS } from '../../data/plans';
import { APP_URLS } from '../../data/site';
---

<section id="planos" class="scroll-mt-24 bg-slate-50 py-16 md:py-24">
  <Container>
    <SectionTitle
      eyebrow="Planos"
      title="Comece pequeno, escale quando o time crescer"
      description="Sem contrato de fidelidade e sem custo de implantação. Você cria a conta e já começa a treinar com dado."
    />

    <div class="mt-12 grid items-start gap-6 lg:grid-cols-3">
      {
        PLANS.map((plan) => (
          <div
            class={`relative flex h-full flex-col rounded-xl bg-white p-6 shadow-sm ${
              plan.highlighted
                ? 'border-2 border-teal-600 lg:-mt-4 lg:pb-10'
                : 'border border-slate-200'
            }`}
          >
            {plan.highlighted && (
              <span class="absolute -top-3 left-6 inline-flex items-center rounded-full bg-teal-600 px-3 py-1 text-xs font-medium text-white">
                Mais escolhido
              </span>
            )}

            <h3 class="text-lg font-semibold text-slate-900">{plan.name}</h3>
            <p class="mt-2 text-sm font-medium leading-relaxed text-slate-500">
              {plan.description}
            </p>

            <p class="mt-6 flex items-baseline gap-1">
              <span class="text-3xl font-semibold tracking-tight text-slate-900">
                {plan.price}
              </span>
              {plan.priceSuffix && (
                <span class="text-sm font-medium text-slate-500">
                  {plan.priceSuffix}
                </span>
              )}
            </p>

            <ul class="mt-6 flex-1 space-y-3">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm font-medium text-slate-700">
                  <Check
                    class="mt-0.5 h-4 w-4 shrink-0 text-teal-600"
                    aria-hidden="true"
                  />
                  {feature}
                </li>
              ))}
            </ul>

            <Button
              href={plan.name === 'Enterprise' ? APP_URLS.comercial : APP_URLS.register}
              variant={plan.highlighted ? 'primary' : 'secondary'}
              class="mt-8 w-full"
            >
              {plan.ctaLabel}
            </Button>
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-center text-sm font-medium text-slate-500">
      Todos os planos incluem transcrição, leitura por IA e score por critério
      do playbook.
    </p>
  </Container>
</section>
