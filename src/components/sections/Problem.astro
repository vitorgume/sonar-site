---
import { EarOff, BookX, Hourglass } from 'lucide-astro';
import Container from '../ui/Container.astro';
import SectionTitle from '../ui/SectionTitle.astro';

const problems = [
  {
    icon: EarOff,
    title: 'O treinamento é feito por opinião',
    description:
      'Sem ouvir as ligações, o feedback vira percepção. O vendedor recebe conselho genérico em vez de saber exatamente qual trecho da conversa precisa mudar.',
  },
  {
    icon: BookX,
    title: 'O playbook não chega na ligação',
    description:
      'O material de treinamento existe, mas ninguém mede se ele está sendo aplicado. Não há dado que mostre a distância entre o que foi treinado e o que é falado.',
  },
  {
    icon: Hourglass,
    title: 'A rampagem demora demais',
    description:
      'Cada vendedor novo aprende sozinho, repetindo os mesmos erros. Sem uma base de calls reais, o onboarding depende da agenda de quem já está ocupado vendendo.',
  },
];
---

<section class="bg-slate-50 py-16 md:py-24">
  <Container>
    <SectionTitle
      eyebrow="O problema"
      title="Seu time é treinado sem nenhum dado da ligação"
      description="A conversa que decide a venda é justamente a que nunca vira material de treinamento — porque ninguém consegue medir o que aconteceu nela."
    />

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        problems.map((problem) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-rose-50">
              <problem.icon class="h-5 w-5 text-rose-700" aria-hidden="true" />
            </div>
            <h3 class="mt-4 text-lg font-semibold text-slate-900">
              {problem.title}
            </h3>
            <p class="mt-2 text-sm font-medium leading-relaxed text-slate-500">
              {problem.description}
            </p>
          </div>
        ))
      }
    </div>
  </Container>
</section>
