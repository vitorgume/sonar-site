---
import { EarOff, ClipboardX, Repeat } from 'lucide-astro';
import Container from '../ui/Container.astro';
import SectionTitle from '../ui/SectionTitle.astro';

const problems = [
  {
    icon: EarOff,
    title: 'Ninguém ouve as ligações',
    description:
      'Escutar call por call é inviável na prática. Sem isso, o gestor decide com base no que o vendedor conta — e não no que realmente aconteceu.',
  },
  {
    icon: ClipboardX,
    title: 'O CRM chega pela metade',
    description:
      'Anotação feita às pressas entre uma ligação e outra perde o contexto. O follow-up seguinte começa do zero e o cliente sente.',
  },
  {
    icon: Repeat,
    title: 'A mesma objeção derruba o funil',
    description:
      'Quando a objeção não é registrada, ela se repete em silêncio. O time inteiro perde negócios pelo mesmo motivo, mês após mês.',
  },
];
---

<section class="bg-slate-50 py-16 md:py-24">
  <Container>
    <SectionTitle
      eyebrow="O problema"
      title="Sua operação comercial perde informação todo dia"
      description="A conversa mais importante do processo de vendas é justamente a que não fica registrada em lugar nenhum."
    />

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        problems.map((problem) => (
          <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-rose-50">
              <problem.icon class="h-5 w-5 text-rose-700" aria-hidden="true" />
            </div>
            <h3 class="mt-4 text-lg font-semibold text-slate-900">
              {problem.title}
            </h3>
            <p class="mt-2 text-sm font-medium leading-relaxed text-slate-500">
              {problem.description}
            </p>
          </div>
        ))
      }
    </div>
  </Container>
</section>
